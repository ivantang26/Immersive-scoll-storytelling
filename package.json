{
  "name": "vela-microsite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vela e-bike launch microsite: scroll-driven story, specs, 3D configurator and test ride booking.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node ./dist/server/entry.mjs",
