  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/vercel": "^11.0.11",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5",
    "lenis": "^1.3.26",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@napi-rs/canvas": "^1.0.10",
    "draco3dgltf": "^1.5.7"
  }
