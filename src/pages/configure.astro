---
import Base from '../layouts/Base.astro';
import { COLOURWAYS, ACCESSORIES, PRODUCT, formatGBP } from '../config/product.js';
---

<Base title="Configure your Vela" description="Choose a colour, add a rear rack or front basket, and see your Vela in 3D. Save an image to share." current="configure">
  <main id="main" class="cfg">
    <div class="cfg__viewer">
      <img
        class="cfg__fallback"
        data-fallback
        src="/media/configure/obsidian-norack-nobasket.webp"
        alt="Vela in Obsidian, no accessories."
        width="1200"
        height="800"
        decoding="async"
      />
      <canvas class="cfg__canvas" data-canvas hidden role="img" aria-label="3D view of your Vela. Drag to rotate."></canvas>
      <div class="cfg__loading" data-loading hidden aria-hidden="true"><span></span></div>
      <p class="cfg__status label" data-status role="status" aria-live="polite"></p>
    </div>

    <form class="cfg__panel" data-form>
      <h1 class="cfg__title">Configure your Vela</h1>

      <fieldset class="cfg__group">
        <legend>Colour <span class="label" data-colour-name>Obsidian</span></legend>
        <div class="swatch-row">
          {COLOURWAYS.map((c, i) => (
            <label class="swatch" style={`--swatch:${c.swatch}`}>
              <input type="radio" name="colour" value={c.id} data-paint={c.paint} data-name={c.name} checked={i === 0} />
              <span class="swatch__chip" aria-hidden="true"></span>
              <span class="sr-only">{c.name}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="cfg__group">
        <legend>Accessories</legend>
        {ACCESSORIES.map((a) => (
          <label class="toggle">
            <input type="checkbox" name={a.id} value="1" data-price={a.price} />
            <span class="toggle__text">
              <span class="toggle__name">{a.name}</span>
              <span class="toggle__note">{a.note}</span>
            </span>
            <span class="toggle__price tabular">+{formatGBP(a.price)}</span>
          </label>
        ))}
      </fieldset>

      <div class="cfg__total">
        <span>Total</span>
        <output class="tabular" data-total data-base={PRODUCT.price}>{formatGBP(PRODUCT.price)}</output>
      </div>

      <div class="cfg__actions">
        <a class="btn btn--primary" data-book href="/test-ride?colour=obsidian">Book a test ride</a>
        <button class="btn" type="button" data-shot>Save image</button>
      </div>
      <p class="cfg__hint" data-hint>Drag the bike to rotate it.</p>
    </form>
  </main>

  <script>
    import { initConfigurator } from '../scripts/configurator/configurator.js';
    initConfigurator();
  </script>
</Base>

<style>
  .cfg {
    min-height: 100dvh;
    padding-top: var(--header-h);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
  }
  .cfg__viewer {
    position: relative;
    min-height: 420px;
    background: radial-gradient(80% 70% at 50% 55%, #1e1c25, var(--night) 75%);
    overflow: hidden;
  }
  .cfg__fallback,
  .cfg__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    touch-action: none;
  }
  .cfg__canvas {
    cursor: grab;
  }
  .cfg__canvas:active {
    cursor: grabbing;
  }
  .cfg__loading {
    position: absolute;
    left: 50%;
    bottom: 32px;
    width: min(240px, 50%);
    height: 2px;
    transform: translateX(-50%);
    background: var(--line);
  }
  .cfg__loading span {
    display: block;
    height: 100%;
    width: calc(var(--p, 0) * 100%);
    background: var(--copper);
    transition: width 0.2s linear;
  }
  .cfg__status {
    position: absolute;
    left: var(--gutter);
    bottom: 20px;
    margin: 0;
  }
  .cfg__panel {
    border-left: 1px solid var(--line);
    padding: clamp(24px, 3vw, 40px);
    display: grid;
    align-content: start;
    gap: 28px;
    background: var(--night);
  }
  .cfg__title {
    margin: 0;
    font-size: clamp(28px, 1.6vw + 16px, 40px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .cfg__group {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .cfg__group legend {
    font-weight: 500;
    margin-bottom: 12px;
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .swatch-row {
    display: flex;
    gap: 14px;
  }
  .swatch {
    position: relative;
    cursor: pointer;
  }
  .swatch input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .swatch__chip {
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow:
      0 0 0 1px rgb(241 237 230 / 0.3),
      inset 0 0 0 4px var(--swatch),
      inset 0 0 0 5px var(--copper);
    transition: box-shadow 0.2s var(--ease-out);
  }
  .swatch input:checked + .swatch__chip {
    box-shadow:
      0 0 0 2px var(--night),
      0 0 0 4px var(--bone),
      inset 0 0 0 4px var(--swatch),
      inset 0 0 0 5px var(--copper);
  }
  .swatch input:focus-visible + .swatch__chip {
    outline: 2px solid var(--copper);
    outline-offset: 6px;
  }
  .toggle {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .toggle:has(input:checked) {
    border-color: var(--copper);
    background: rgb(208 138 78 / 0.08);
  }
  .toggle input {
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--copper);
  }
  .toggle__text {
    display: grid;
  }
  .toggle__note {
    font-size: 14px;
    color: #a9a6ae;
  }
  .cfg__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid var(--line-strong);
    padding-top: 18px;
    font-size: 18px;
  }
  .cfg__total output {
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .cfg__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cfg__hint {
    margin: 0;
    font-size: 14px;
    color: #a9a6ae;
  }
  @media (max-width: 960px) {
    .cfg {
      grid-template-columns: 1fr;
      grid-template-rows: 56svh auto;
    }
    .cfg__viewer {
      min-height: 0;
    }
    .cfg__panel {
      border-left: 0;
      border-top: 1px solid var(--line);
      gap: 22px;
    }
  }
</style>
