---
import Base from '../layouts/Base.astro';
import { KEY_SPECS, SPEC_GROUPS, GEOMETRY, COLOURWAYS, ACCESSORIES, PRODUCT, formatGBP } from '../config/product.js';
---

<Base
  title="Vela specs | 120 km range, 16.8 kg, from £3,400"
  description="Full Vela e-bike specifications: motor, battery, frame geometry, drive, lights, colours, accessories and price."
  current="specs"
>
  <main id="main" class="page specs-page">
    <div class="container">
      <header class="specs-head">
        <h1 class="page-title">Vela specifications</h1>
        <p class="page-intro">Everything in one place. From <strong class="tabular">{formatGBP(PRODUCT.price)}</strong>, including fenders, lights and a two-year warranty.</p>
      </header>

      <section aria-labelledby="key-title" class="key">
        <h2 id="key-title" class="sr-only">Key figures</h2>
        <dl class="key-grid">
          {KEY_SPECS.map((s, i) => (
            <div class:list={['key-tile', { 'key-tile--lead': i === 0 }]}>
              <dt class="label">{s.label}</dt>
              <dd>
                <span class="key-num tabular">{s.value}</span><span class="key-unit">{s.unit}</span>
                <p class="key-note">{s.note}</p>
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="groups" aria-labelledby="full-title">
        <h2 id="full-title" class="section-title">Full specification</h2>
        <div class="group-grid">
          {SPEC_GROUPS.map((g) => (
            <section class="group" aria-labelledby={`g-${g.title}`}>
              <h3 id={`g-${g.title}`}>{g.title}</h3>
              <dl>
                {g.rows.map(([k, v]) => (
                  <div class="row">
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))}
        </div>
      </section>

      <section class="geometry" aria-labelledby="geo-title">
        <h2 id="geo-title" class="section-title">Sizes and geometry</h2>
        <div class="table-wrap" tabindex="0" role="region" aria-labelledby="geo-title">
          <table>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Measurement</span></th>
                {GEOMETRY.columns.map((c) => <th scope="col">{c}</th>)}
              </tr>
            </thead>
            <tbody>
              {GEOMETRY.rows.map(([label, ...vals]) => (
                <tr>
                  <th scope="row">{label}</th>
                  {vals.map((v) => <td class="tabular">{v}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="extras" aria-labelledby="extras-title">
        <h2 id="extras-title" class="section-title">Colours and accessories</h2>
        <div class="extras-grid">
          <ul class="swatches" aria-label="Colours">
            {COLOURWAYS.map((c) => (
              <li>
                <img src={`/media/colourways/${c.id}-800.webp`} alt={`Vela in ${c.name}`} width="800" height="640" loading="lazy" decoding="async" />
                <span class="cw-name"><span class="dot" style={`--swatch:${c.swatch}`} aria-hidden="true"></span>{c.name}</span>
              </li>
            ))}
          </ul>
          <dl class="acc">
            {ACCESSORIES.map((a) => (
              <div class="row">
                <dt>{a.name}</dt>
                <dd><span class="tabular">+{formatGBP(a.price)}</span> <span class="acc-note">{a.note}</span></dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section class="specs-cta" aria-label="Next steps">
        <a class="btn btn--primary" href="/test-ride" data-track="specs_test_ride">Book a test ride</a>
        <a class="btn" href="/configure">Configure yours</a>
        <a class="specs-cta__link" href="/press">Press kit and images</a>
      </section>
    </div>
  </main>
</Base>

<style>
  .specs-head {
    max-width: 900px;
  }
  .key {
    margin-top: clamp(40px, 6vw, 80px);
  }
  .key-grid {
    margin: 0;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 12px;
  }
  .key-tile {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(20px, 2.4vw, 32px);
    display: grid;
    align-content: space-between;
    gap: 24px;
  }
  /* Four tiles in a 3x2 grid: lead spans two rows, the last spans two columns. No empty cells. */
  .key-tile:last-child {
    grid-column: span 2;
  }
  .key-tile--lead {
    grid-row: span 2;
    background:
      radial-gradient(120% 90% at 100% 100%, rgb(208 138 78 / 0.22), transparent 60%),
      var(--dusk);
  }
  .key-tile dd {
    margin: 0;
  }
  .key-num {
    font-size: clamp(48px, 5vw + 12px, 96px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }
  .key-tile--lead .key-num {
    font-size: clamp(64px, 8vw + 16px, 140px);
  }
  .key-unit {
    margin-left: 0.2em;
    color: var(--mute);
    font-size: clamp(18px, 1.2vw + 10px, 28px);
  }
  .key-note {
    margin: 12px 0 0;
    color: #a9a6ae;
    font-size: 15px;
    max-width: 32ch;
  }
  .section-title {
    font-size: clamp(28px, 2vw + 16px, 44px);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 28px;
  }
  .groups,
  .geometry,
  .extras {
    margin-top: clamp(72px, 9vw, 128px);
  }
  .group-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px clamp(32px, 5vw, 80px);
  }
  .group h3 {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 500;
    color: var(--copper);
  }
  .group dl,
  .acc {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(120px, 0.8fr) 2fr;
    gap: 16px;
    padding: 12px 0;
  }
  .row dt {
    color: var(--mute);
  }
  .row dd {
    margin: 0;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 520px;
  }
  th,
  td {
    text-align: left;
    padding: 14px 20px;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--mute);
    font-weight: 400;
    border-bottom: 1px solid var(--line-strong);
  }
  tbody th {
    font-weight: 400;
    color: var(--mute);
  }
  tbody tr:nth-child(even) {
    background: rgb(241 237 230 / 0.03);
  }
  .extras-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .swatches {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .swatches img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .cw-name {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
  }
  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: 0 0 0 1px rgb(241 237 230 / 0.35);
  }
  .acc-note {
    display: block;
    color: #a9a6ae;
    font-size: 15px;
  }
  .specs-cta {
    margin-top: clamp(72px, 9vw, 128px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .specs-cta__link {
    margin-left: 8px;
    text-underline-offset: 5px;
    text-decoration-color: var(--copper);
  }
  @media (max-width: 900px) {
    .key-grid {
      grid-template-columns: 1fr 1fr;
    }
    .key-tile--lead {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .key-tile:last-child {
      grid-column: 1 / -1;
    }
    .group-grid,
    .extras-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .swatches {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
